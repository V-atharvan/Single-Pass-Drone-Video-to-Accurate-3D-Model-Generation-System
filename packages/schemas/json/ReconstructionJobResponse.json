{
  "$defs": {
    "JobState": {
      "description": "The 15 canonical reconstruction job lifecycle states defined in PRD Section 30.",
      "enum": [
        "QUEUED",
        "VALIDATING",
        "EXTRACTING_FRAMES",
        "ESTIMATING_POSE",
        "ESTIMATING_DEPTH",
        "SEGMENTING",
        "FUSING",
        "RECONSTRUCTING",
        "TEXTURING",
        "GEOREFERENCING",
        "QUALITY_CHECK",
        "GENERATING_TILES",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobState",
      "type": "string"
    },
    "QualityPreset": {
      "description": "Reconstruction resolution and processing density preset.",
      "enum": [
        "LOW",
        "BALANCED",
        "HIGH"
      ],
      "title": "QualityPreset",
      "type": "string"
    }
  },
  "description": "API response model for a reconstruction job.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "flight_id": {
      "format": "uuid",
      "title": "Flight Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "org_id": {
      "format": "uuid",
      "title": "Org Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobState"
    },
    "quality_preset": {
      "$ref": "#/$defs/QualityPreset"
    },
    "current_stage": {
      "title": "Current Stage",
      "type": "string"
    },
    "progress_percent": {
      "default": 0.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Progress Percent",
      "type": "number"
    },
    "frames_processed": {
      "default": 0,
      "minimum": 0,
      "title": "Frames Processed",
      "type": "integer"
    },
    "frames_total": {
      "default": 0,
      "minimum": 0,
      "title": "Frames Total",
      "type": "integer"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    }
  },
  "required": [
    "id",
    "flight_id",
    "project_id",
    "org_id",
    "status",
    "quality_preset",
    "current_stage",
    "created_at"
  ],
  "title": "ReconstructionJobResponse",
  "type": "object"
}