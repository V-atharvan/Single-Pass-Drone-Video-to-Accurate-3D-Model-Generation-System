{
  "$defs": {
    "CameraPose": {
      "description": "Optimized 6-Degrees-of-Freedom camera extrinsic pose.",
      "properties": {
        "frame_index": {
          "description": "Extracted keyframe sequential index",
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "timestamp_offset_seconds": {
          "description": "Video timestamp offset",
          "minimum": 0.0,
          "title": "Timestamp Offset Seconds",
          "type": "number"
        },
        "rotation_matrix": {
          "description": "3x3 orthonormal rotation matrix from camera to world frame",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Rotation Matrix",
          "type": "array"
        },
        "translation_vector": {
          "description": "3-element translation vector [x, y, z] in world coordinates (meters)",
          "items": {
            "type": "number"
          },
          "title": "Translation Vector",
          "type": "array"
        },
        "reprojection_error_px": {
          "description": "Feature reprojection error RMSE in pixels",
          "minimum": 0.0,
          "title": "Reprojection Error Px",
          "type": "number"
        },
        "pose_confidence": {
          "description": "Pose certainty score (0-100%)",
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Pose Confidence",
          "type": "number"
        }
      },
      "required": [
        "frame_index",
        "timestamp_offset_seconds",
        "rotation_matrix",
        "translation_vector",
        "reprojection_error_px",
        "pose_confidence"
      ],
      "title": "CameraPose",
      "type": "object"
    },
    "GPSRecord": {
      "description": "Raw and interpolated GPS coordinate records.",
      "properties": {
        "latitude": {
          "description": "Latitude in decimal degrees (WGS84)",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "description": "Longitude in decimal degrees (WGS84)",
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        },
        "altitude_msl": {
          "description": "Altitude above Mean Sea Level in meters",
          "title": "Altitude Msl",
          "type": "number"
        },
        "altitude_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Takeoff-relative altitude in meters",
          "title": "Altitude Relative"
        },
        "speed_mps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ground speed in meters per second",
          "title": "Speed Mps"
        },
        "heading_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Compass heading in degrees [0, 360)",
          "title": "Heading Deg"
        },
        "timestamp_offset_seconds": {
          "description": "Elapsed seconds from video start",
          "minimum": 0.0,
          "title": "Timestamp Offset Seconds",
          "type": "number"
        },
        "hdop": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Horizontal Dilution of Precision",
          "title": "Hdop"
        },
        "vdop": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vertical Dilution of Precision",
          "title": "Vdop"
        },
        "num_satellites": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Locked satellite count",
          "title": "Num Satellites"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "altitude_msl",
        "timestamp_offset_seconds"
      ],
      "title": "GPSRecord",
      "type": "object"
    }
  },
  "description": "Metadata for an extracted video keyframe.",
  "properties": {
    "frame_index": {
      "minimum": 0,
      "title": "Frame Index",
      "type": "integer"
    },
    "source_video_timestamp_sec": {
      "minimum": 0.0,
      "title": "Source Video Timestamp Sec",
      "type": "number"
    },
    "keyframe_s3_key": {
      "title": "Keyframe S3 Key",
      "type": "string"
    },
    "blur_score": {
      "description": "Laplacian sharpness metric (higher = sharper)",
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Blur Score",
      "type": "number"
    },
    "exposure_score": {
      "description": "Luminance balance metric",
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Exposure Score",
      "type": "number"
    },
    "gps": {
      "anyOf": [
        {
          "$ref": "#/$defs/GPSRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pose": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraPose"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "is_selected": {
      "default": true,
      "description": "Whether selected for 3D reconstruction pipeline",
      "title": "Is Selected",
      "type": "boolean"
    }
  },
  "required": [
    "frame_index",
    "source_video_timestamp_sec",
    "keyframe_s3_key",
    "blur_score",
    "exposure_score"
  ],
  "title": "KeyframeMetadata",
  "type": "object"
}